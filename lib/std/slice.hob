import "lib.hob" as std;

public type Slice<T> = struct {
    public raw: *T,
    public length: usize,
};

public fun new<T>(raw: *T, length: usize) -> Slice.<T> {
    return <(Slice.<T>)> {
        raw: raw,
        length: length,
    };
}

public fun empty<T>() -> Slice.<T> {
    return new.<T>(std.null.<T>(), 0);
}

public fun Slice.atRef(self, idx: usize) -> *T {
    return &self.raw[idx];
}

public fun Slice.at(self, idx: usize) -> T {
    return self.raw[idx];
}

public fun Slice.subslice(self, begin: usize, end: usize) -> Slice.<T> {
    var result = self;
    result.raw = &result.raw[begin];
    if end <= begin {
        result.length = 0;
    } else {
        result.length = end - begin;
    }
    return result;
}
