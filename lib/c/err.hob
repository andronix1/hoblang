import result;
import std;
import "lib.hob" as c;

use result.Result;

public fun errFrom<T>(errno: i32) -> Result.<T> {
    return result.err.<T>(std.str.fromC(c.strerror(errno)));
}

public fun err<T>() -> Result.<T> {
    return errFrom.<T>(c.errno().*);
}

public fun handle(value: i32) -> Result.<i32> {
    if value < 0 {
        return err.<i32>();
    }
    return result.ok.<i32>(value);
}

public fun handleIgnored(value: i32, filter: fun (i32) -> bool) -> Result.<i32> {
    if value < 0 && !filter(c.errno().*) {
        return err.<i32>();
    }
    return result.ok.<i32>(value);
}

public fun handleMapped<T>(value: i32, mapper: fun (i32) -> T) -> Result.<T> {
    if value < 0 {
        return err.<T>();
    }
    return result.ok.<T>(mapper(value));
}

public fun handleNone(value: i32) -> Result.<std.None> {
    if value < 0 {
        return err.<std.None>();
    }
    return result.ok.<std.None>(std.none());
}

