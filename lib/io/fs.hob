import "fd.hob" as fd;

import result;
import strings;
import c;

use result.Result;

public type File = fd.Fd;

public type OpenFlags = enum (i32) {
    none = 0,
    writeOnly = 1,
    readWrite = 2,
    create = 100,
    exclusive = 200,
    trunc = 1000,
    append = 2000,
};
public fun OpenFlags.with(self, value: OpenFlags) -> OpenFlags { return (self as i32 + value as i32) as OpenFlags; }

public fun open(path: string, flags: OpenFlags) -> Result.<File> {
    var cPath = strings.fromString(path);
    defer cPath.free();
    return c.err.handleMapped.<File>(c.open(cPath.makeC(), flags as i32), fun (res) {
        return res as File;
    });
}
